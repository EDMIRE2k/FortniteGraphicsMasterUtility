<Window x:Class="FortniteCinematicSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Graphics Master Utility"
        Icon="Assets/app-icon.ico"
        Width="1190"
        Height="935"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <DockPanel Margin="12,8,8,16">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="10,8,10,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1">
                                <Image Source="Assets/app-icon.png"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Fortnite Graphics"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Master Utility"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource NavButtonStyle}" Tag="Selected">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" Style="{StaticResource IconTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Graphics" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}"/>
                                <TextBlock Text="Refresh from file" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="ChooseFileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource IconTextStyle}"/>
                                <TextBlock Text="Choose config file" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" Style="{StaticResource NavButtonStyle}" Click="OpenFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}"/>
                                <TextBlock Text="Open config folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource NavButtonStyle}" Click="UndoButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}"/>
                                <TextBlock Text="Restore backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" Style="{StaticResource IconTextStyle}"/>
                                <TextBlock Text="Get help" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Margin="12,10,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="App theme" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="100" SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="System" IsSelected="True"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="900" Margin="30,24,30,34" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Graphics" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="&#xE76C;" Style="{StaticResource IconTextStyle}" Margin="12,3,4,0"/>
                            <TextBlock Text="Quality settings" FontSize="28" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Manage hidden Fortnite rendering quality values and recovery options."
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock Text="Preset and mode" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Quality preset"/>
                                    <TextBlock x:Name="PresetDescriptionText" Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="PresetBox"
                                          Grid.Column="2"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="PresetBox_SelectionChanged"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE945;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Lumen Fix"/>
                                    <TextBlock Text="Exclusive mode. Only writes ray tracing and Lumen/global illumination values at tier 3."
                                               Margin="0,2,12,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="LumenFixStateText" Text="Off" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LumenFixCheck"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="LumenFixCheck_Changed"
                                              Unchecked="LumenFixCheck_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,24,0,0">
                        <TextBlock Text="Rendering features" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE9CA;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nanite virtualized geometry"/>
                                    <TextBlock Text="Enables Fortnite's high-detail Nanite geometry system." Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="NaniteStateText" Text="On" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="NaniteCheck" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE706;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ray tracing"/>
                                    <TextBlock Text="Enables the ray tracing flag used by Lumen and reflections." Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="RayTracingStateText" Text="On" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="RayTracingCheck" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Protect settings file"/>
                                    <TextBlock Text="Sets GameUserSettings.ini to read-only after applying." Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ReadOnlyStateText" Text="On" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ReadOnlyCheck" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,24,0,0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quality settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Height="34"
                                    Background="{DynamicResource ControlBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" Style="{StaticResource IconTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0,5"
                                             ToolTip="Find a setting"
                                             TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ItemsControl x:Name="SettingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE9E9;" Style="{StaticResource IconTextStyle}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding Description}" Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.QualityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,24,0,0">
                        <TextBlock Text="File and recovery" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GameUserSettings.ini"/>
                                    <TextBlock x:Name="ConfigPathBox" Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <Button Content="Choose file" Click="ChooseFileButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest backup"/>
                                    <TextBlock x:Name="ProtectionText" Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Restore" Click="UndoButton_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,24,0,0">
                        <TextBlock Text="Advanced" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="Pending INI values"/>
                                        <TextBlock Text="Review exactly what will be written before applying." Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <TextBox x:Name="PreviewBox"
                                         Margin="0,12,0,0"
                                         Height="250"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Expander>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

                <Border Grid.Row="1"
                        Padding="22,14,22,16"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid MaxWidth="900" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Padding="14,10"
                                CornerRadius="4"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardStrokeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;"
                                           Style="{StaticResource IconTextStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GPU warning"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="Cinematic and Photography values have immense GPU requirements. Use an upscaler unless the system has at least an RTX 4090 or RTX 5090."
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MessageText"
                                       Margin="0,0,24,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="ApplyButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="170"
                                    Content="Apply settings"
                                    Click="ApplyButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
</Window>
