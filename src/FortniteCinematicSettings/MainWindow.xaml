<Window x:Class="FortniteCinematicSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Graphics Master Utility" Icon="Assets/app-icon.ico"
        Width="1180" Height="860" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="14,22,14,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="4,0,4,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="Assets/app-icon.png" Width="40" Height="40" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <TextBlock Text="Fortnite Graphics" FontWeight="SemiBold"/>
                    <TextBlock Text="Master Utility" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1">
                <RadioButton x:Name="GraphicsNav" GroupName="Navigation" Style="{StaticResource Navigation}" Tag="Graphics" IsChecked="True" Checked="Navigate">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Graphics"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ChangesNav" GroupName="Navigation" Style="{StaticResource Navigation}" Tag="Changes" Checked="Navigate">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Changes"/><TextBlock x:Name="NavChangeCount" Style="{StaticResource Caption}" Margin="10,2,0,0"/></StackPanel>
                </RadioButton>
                <RadioButton x:Name="RecoveryNav" GroupName="Navigation" Style="{StaticResource Navigation}" Tag="Recovery" Checked="Navigate">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="File &amp; recovery"/></StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="8,0">
                <TextBlock Text="APPEARANCE" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemeBox" SelectedIndex="0" SelectionChanged="ThemeChanged" MinHeight="34" AutomationProperties.Name="App theme">
                    <ComboBoxItem Content="Use system setting"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                </ComboBox>
                <TextBlock Text="Version 3.0" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="28,22,28,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Graphics" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Rendering and visual quality" Style="{StaticResource Caption}" Margin="0,5,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileStatus" Text="Config connected" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}" Click="RefreshClick" ToolTip="Reload settings from file" AutomationProperties.Name="Reload settings">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="GraphicsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" CanContentScroll="False">
                <StackPanel Margin="28,0,28,24">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Rendering mode" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SavedModeText" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="Dx12Choice" GroupName="Renderer" Style="{StaticResource ModeChoice}" Checked="RendererChanged"
                                     AutomationProperties.Name="DirectX 12">
                            <StackPanel><TextBlock Text="DirectX 12" FontWeight="SemiBold"/><TextBlock Text="Full graphics" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PerformanceChoice" GroupName="Renderer" Style="{StaticResource ModeChoice}" Checked="RendererChanged"
                                     AutomationProperties.Name="Performance Mode">
                            <StackPanel><TextBlock Text="Performance" FontWeight="SemiBold"/><TextBlock Text="Lightweight DX12 renderer" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock x:Name="RendererHint" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

                    <TextBlock Text="Quality profile" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="Preset" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PresetDescriptionText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="PresetBox" Grid.Column="1" VerticalAlignment="Center" MinHeight="34"
                                      DisplayMemberPath="Name" SelectionChanged="PresetChanged" AutomationProperties.Name="Quality preset"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingRow}" Margin="0,0,5,5">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Nanite"/><TextBlock Text="Virtualized geometry" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                                <CheckBox x:Name="NaniteCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="FeatureChanged" Unchecked="FeatureChanged" AutomationProperties.Name="Nanite"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource SettingRow}" Margin="5,0,0,5">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Ray tracing"/><TextBlock Text="Hardware lighting" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                                <CheckBox x:Name="RayTracingCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="FeatureChanged" Unchecked="FeatureChanged" AutomationProperties.Name="Ray tracing"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Lumen Fix"/>
                                <TextBlock Text="Exclusive lighting fix, tier 3. Requires saved DirectX 12 mode." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="LumenFixCheck" Grid.Column="1" Style="{StaticResource Switch}" Checked="LumenChanged" Unchecked="LumenChanged" AutomationProperties.Name="Lumen Fix"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,20,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Individual settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" MinHeight="34" Padding="30,6,10,6" TextChanged="SearchChanged"
                                     AutomationProperties.Name="Search quality settings" ToolTip="Search quality settings"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Search settings" Margin="30,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="NoResultsText" Text="No matching settings" Visibility="Collapsed" Style="{StaticResource Caption}" Margin="0,16"/>
                    <ItemsControl x:Name="SettingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"
                                                  VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Name}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ChangesPage" Grid.Row="1" Visibility="Collapsed" Margin="28,0,28,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="ChangesSummary" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ChangesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Key}" FontSize="13"/><TextBlock Text="{Binding DisplaySection}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Before}" Style="{StaticResource Caption}" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding After, StringFormat=To {0}}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Expander Grid.Row="2" Header="Pending INI values" Margin="0,12,0,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="PreviewBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" MaxHeight="170"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Pending INI preview"/>
                        <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,6" Click="CopyPreviewClick">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Copy values"/></StackPanel>
                        </Button>
                    </Grid>
                </Expander>
            </Grid>

            <ScrollViewer x:Name="RecoveryPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,0,28,24">
                    <TextBlock Text="Configuration file" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox x:Name="ConfigPathBox" IsReadOnly="True" TextWrapping="Wrap" Padding="12" AutomationProperties.Name="Configuration file path"/>
                    <WrapPanel Margin="0,12,0,8">
                        <Button Click="ChooseFileClick" Padding="12,7" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Choose file"/></StackPanel></Button>
                        <Button x:Name="OpenFolderButton" Click="OpenFolderClick" Padding="12,7" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Open folder"/></StackPanel></Button>
                        <Button Click="DetectFileClick" Padding="12,7" Margin="0,0,0,8"><TextBlock Text="Auto-detect"/></Button>
                    </WrapPanel>
                    <TextBlock Text="Protection" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Read-only after applying"/>
                                <TextBlock Text="Recommended to retain edits. Fortnite cannot save other settings while locked." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ReadOnlyCheck" IsChecked="True" Grid.Column="1" Style="{StaticResource Switch}" Checked="ProtectionChanged" Unchecked="ProtectionChanged" AutomationProperties.Name="Protect settings file"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProtectionText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="UnlockButton" Grid.Column="1" Content="Unlock file now" Click="UnlockClick" Padding="12,6"/>
                    </Grid>
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="BackupText" Style="{StaticResource Caption}"/>
                    <Button x:Name="UndoButton" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,7" Click="RestoreClick">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Restore latest backup"/></StackPanel>
                    </Button>
                    <TextBlock Text="A complete backup is created beside the INI before each apply. Restoring also unlocks the file." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <TextBlock Text="Launcher overrides" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Epic Launcher command-line arguments can override the saved rendering mode. Remove conflicting rendering arguments if Fortnite starts in a different mode." Style="{StaticResource Caption}"/>
                    <Button Click="HelpClick" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Epic rendering mode help"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" FontSize="16" Margin="0,2,0,0"/>
                        <TextBlock x:Name="WarningText" Grid.Column="1" FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock x:Name="OperationText" Grid.Row="1" FontSize="12" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="PendingText" Text="No pending changes" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="ApplyHint" Text="A backup is created before applying." Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="DiscardButton" Grid.Column="1" Padding="14,8" Margin="0,0,10,0" VerticalAlignment="Center" Click="DiscardClick" ToolTip="Discard pending changes">
                            <TextBlock Text="Discard"/>
                        </Button>
                        <Button x:Name="ApplyButton" Grid.Column="2" MinWidth="142" Height="38" Padding="16,8" VerticalAlignment="Center"
                                Style="{StaticResource ApplyButtonStyle}"
                                Click="ApplyClick" AutomationProperties.Name="Apply settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ApplyLabel" Text="Apply settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
